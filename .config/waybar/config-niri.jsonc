{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 10,
  "height": 40,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/cava-internal", "niri/language", "cpu", "memory", "temperature", "pulseaudio", "network", "tray", "custom/power"],

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": " ",
      "default":" "
    }
  },

  "niri/window": {
    "format": "{}",
    "max-length": 60,
    "icon": true,
    "icon-size": 16
  },

  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰸗 {:%a %d %b %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%",
    "tooltip": true,
    "on-click": "ghostty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "on-click": "ghostty -e btop"
  },

  "temperature": {
    "interval": 5,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󱃃", "󰔏", "󱃂", "󰸁", "󰸂"],
    "tooltip": true
  },

  "network": {
    "interval": 3,
    "format-ethernet": "󰈀 ",
    "format-wifi": "󰖩 {essid}",
    "format-disconnected": "󰖪 Disconnected",
    "tooltip-format-ethernet": "󰈀 {ipaddr}/{cidr}\n󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes}",
    "tooltip-format-wifi": "󰖩 {essid} ({signalStrength}%)\n󰩟 {ipaddr}/{cidr}\n󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes}",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}\nVolume: {volume}%"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 12,
    "show-passive-items": true
  },

  "custom/cava-internal": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "format": "󰝚 {}",
    "tooltip": false
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
