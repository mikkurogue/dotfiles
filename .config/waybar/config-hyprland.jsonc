{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,

  // All modules in center to create island effect
  "modules-left": [],
  "modules-center": ["hyprland/window", "hyprland/language", "hyprland/workspaces", "tray", "clock", "pulseaudio", "network", "custom/power"],
  "modules-right": [],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 25,
    "icon": true,
    "icon-size": 14,
    "separate-outputs": true
  },

  "hyprland/language": {
    "format": "{short}",
    "tooltip": true,
    "tooltip-format": "{long}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#abb2bf'><b>{}</b></span>",
        "days": "<span color='#abb2bf'>{}</span>",
        "weekdays": "<span color='#61afef'><b>{}</b></span>",
        "today": "<span color='#e06c75'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 18,
    "spacing": 14,
    "show-passive-items": true
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾", "󱄠"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}\n{volume}%"
  },

  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "󰖩",
    "format-disconnected": "󰖪",
    "tooltip-format-ethernet": "󰈀 {ipaddr}/{cidr}\n󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes}",
    "tooltip-format-wifi": "󰖩 {essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5
  }
}
