# theme = osmium 
 theme = onedark_custom

# Font
# font-family = "Hack-ZeroSlash"
font-family = CaskaydiaMono Nerd Font Mono
# font-family =  AdwaitaMono Nerd Font Mono
font-feature = -dlig
font-feature = -calt
# font-feature = -liga
font-feature = zero
#font-family = "CaskaydiaMono Nerd Font"
# font-family = "Adwaita Mono"
font-style = Regular
font-size = 16 

# Window
window-padding-y = 10
window-padding-x = 10
window-decoration = none
confirm-close-surface=false
resize-overlay = never
# gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = true 
shell-integration-features = no-cursor

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = ctrl+shift+,=reload_config
# keybind = performable:ctrl+c=copy_to_clipboard
# keybind = performable:ctrl+v=paste_from_clipboard


# make new splits 
keybind = ctrl+shift+u=new_split:up
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+l=new_split:left
keybind = ctrl+shift+r=new_split:right

# focus and navigate splits
keybind = ctrl+shift+n=goto_split:next
keybind = ctrl+shift+p=goto_split:previous

# zoom into current split (temporary maximized until move/focus other split)
keybind = ctrl+shift+z=toggle_split_zoom


mouse-scroll-multiplier = 3

# SSH session terminfo
shell-integration-features = ssh-env

# Shaders
custom-shader = shaders/cursor_smear.glsl
