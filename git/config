[http]
	postBuffer = 157286400
[push]
	autoSetupRemote = true
[credential]
	helper = store
[pull]
	rebase = false
[alias]
    undo = reset --mixed HEAD~1
    unstage = reset HEAD --
    lg = log --oneline --graph --all --decorate
    last = log -1 HEAD
    hist = log --pretty=format:"%h %ad | %s%d [%an]" --graph --date=short
    amend = commit --amend --no-edit
    fix = commit --amend
    restore = checkout --
    purge = "!git fetch -p && git branch --merged | grep -v '\\*' | grep -v 'master' | xargs git branch -d" # use `develop for work i guess or find the "default" some how`
    st = status
    set = checkout
    new = checkout -b
[rerere]
    enabled = true 
